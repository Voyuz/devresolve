# Copy to .env.local only if it does not already exist; fill values locally.
# Never commit real credentials or share them in screenshots, logs, or AI prompts.

# Existing local key name remains supported; passed to Bob Shell 2 as BOB_API_KEY.
BOBSHELL_API_KEY=

# Official Bob Shell 2 key name. Preferred if both key fields are populated.
# Configure either this or BOBSHELL_API_KEY; do not put real keys in this file.
BOB_API_KEY=

# Leave blank for automatic PATH/npm discovery on the current server.
# Optional absolute path override for custom installations (.exe or JS entry).
BOB_SHELL_EXECUTABLE=
# Optional team ID; required by Bob for keys with general scope.
BOB_TEAM_ID=

# Supabase: service-role key must never use a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
# Reserved for future browser/auth integration; current demo uses server access.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only GitHub fine-grained token: target repository, Contents read/write.
GITHUB_TOKEN=
# Optional secret (32+ characters) for signing login sessions. When blank, one is derived
# from SUPABASE_SERVICE_ROLE_KEY. Changing it signs everyone out.
DEVRESOLVE_SESSION_SECRET=

# Optional nonsecret demo settings; leave blank to use these defaults:
# reporter ID: demo (use an existing profile ID if a foreign key requires it)
# category: BUG; issue status: OPEN
DEVRESOLVE_DEMO_REPORTER_ID=
DEVRESOLVE_DEMO_ISSUE_CATEGORY=
DEVRESOLVE_DEMO_ISSUE_STATUS=
